# Copie para .env (que NÃO vai pro git) ou cole no painel de Environment do EasyPanel.
# A chave do Gemini vive SÓ aqui — nunca no front nem no banco.

PORT=3000

# Chave do Google Gemini (grátis): https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-a-sua-chave-aqui
# Modelo (pode deixar o padrão).
GEMINI_MODEL=gemini-2.5-flash

# Supabase SMERP — a chave PUBLISHABLE (anon), a mesma do config.js do Hub.
# NÃO use a service role aqui: o assistente age com o token da própria pessoa.
SUPABASE_URL=https://supabase-supabase.h5xdag.easypanel.host
SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# Origem permitida (CORS). Pode deixar a URL do Hub, ou * para liberar geral.
ALLOWED_ORIGIN=https://solucaomoveis-erp.h5xdag.easypanel.host

# ----- VOZ NEURAL (ElevenLabs) — opcional -----
# Sem ELEVEN_API_KEY, a Sila usa a voz do navegador (Android/PC).
# Chave grátis (sem cartão): https://elevenlabs.io -> Perfil -> API Keys (sk_...)
ELEVEN_API_KEY=cole-a-chave-sk-aqui
# Voz (grátis): Sarah=EXAVITQu4vr4xnSDxMaL | Jessica=cgSgspJ2msm6clMCkdW9 | Bella=hpp4J3VqNfWAUOO0d1Us
ELEVEN_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# turbo = metade dos créditos (estica o grátis)
ELEVEN_MODEL=eleven_turbo_v2_5
# Trava de gasto: para antes dos 10 mil caracteres/mês do plano grátis.
ELEVEN_MONTHLY_LIMIT=9500
