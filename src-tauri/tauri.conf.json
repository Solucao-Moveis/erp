{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMERP",
  "version": "0.1.0",
  "identifier": "br.ind.solucaomoveis.smerp",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SMERP · Solução Móveis",
        "url": "https://solucaomoveis-erp.h5xdag.easypanel.host/",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
