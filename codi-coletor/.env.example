CODI_CLIENT_ID=L9e3vxAWUfhCrDeswmRS0mVTDZMlMxOO
CODI_CLIENT_SECRET=GhcgVsbKJix8PbhsFSWREVaRT219uYSh

# Obter na 1ª vez: node renovar-token.mjs (lê CODI_WS_USER/PASS e salva em .token)
# Após o 1º uso o token rotaciona e é salvo automaticamente em .token
CODI_REFRESH_TOKEN=<colar refresh_token OU usar renovar-token.mjs>

# Empresa usada no password grant e no formulário de login WebSocket
CODI_COMPANY=somvsomvpo
CODI_COMPANY_ID=1

# ─── CODI WebSocket (status ao vivo das máquinas) ─────────────
CODI_ACTION_URL=http://192.168.2.210:8080/action
CODI_WS_USER=<login do CODI — nunca commitar>
CODI_WS_PASS=<senha do CODI — nunca commitar>
CODI_WS_LABEL=000

# IDs das máquinas a monitorar (opcional — usa todos se omitido)
