# URL base da API CODI — ambiente de PRODUÇÃO
CODI_BASE_URL=http://10.7.10.239:8080/API_Industrial18_Producao

# Token de autenticação do CODI (ApiToken enviado no body de cada request)
# NUNCA commitar o valor real — manter só neste .env na máquina da fábrica
CODI_TOKEN=coloque-o-token-real-aqui

# Supabase SMERP
SUPABASE_URL=https://supabase-supabase.h5xdag.easypanel.host
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Intervalo de sincronização em minutos (padrão: 5)
INTERVALO_MIN=5

# Janela de delta em dias (quantos dias pra trás filtrar em cada ciclo)
DELTA_DIAS=3

# Na primeira execução, faz backfill de quantos meses? (padrão: 12)
BACKFILL_MESES=12
